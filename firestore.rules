/* DEVELOPMENT RULES - DISABLED FOR PRODUCTION
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow all reads and writes for now (development mode)
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
*/

// PRODUCTION RULES - ENABLED

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() in ['admin', 'superadmin'];
    }
    
    function isSuperadmin() {
      return isAuthenticated() && getUserRole() == 'superadmin';
    }
    
    function isTrainer() {
      return isAuthenticated() && getUserRole() == 'trainer';
    }
    
    function isPhysiotherapist() {
      return isAuthenticated() && getUserRole() == 'physiotherapist';
    }
    
    // Users collection - Allow public registration
    match /users/{userId} {
      allow read: if true; // Allow reading user data (needed for app functionality)
      allow create: if true; // Allow anyone to register (create user document)
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Trainers collection
    match /trainers/{trainerId} {
      allow read: if true; // Public read for listing trainers
      allow create: if isAdmin();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Physiotherapists collection
    match /physiotherapists/{physioId} {
      allow read: if true; // Public read for listing physiotherapists
      allow create: if isAdmin();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Patients collection
    match /patients/{patientId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isPhysiotherapist() && resource.data.physiotherapistId == request.auth.uid
      );
      allow create: if isPhysiotherapist() || isAdmin();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isPhysiotherapist() && resource.data.physiotherapistId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        isPhysiotherapist() && resource.data.physiotherapistId == request.auth.uid
      );
    }
    
    // Progress tracking collection
    match /progress/{progressId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isPhysiotherapist() && resource.data.physiotherapistId == request.auth.uid
      );
      allow create: if isPhysiotherapist() || isAdmin();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isPhysiotherapist() && resource.data.physiotherapistId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        isPhysiotherapist() && resource.data.physiotherapistId == request.auth.uid
      );
    }
    
    // Physiotherapist requests collection
    match /physio-requests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.physioId == request.auth.uid
      );
      allow create: if isAuthenticated(); // Any user can create a request
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isPhysiotherapist() && resource.data.physioId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.physioId == request.auth.uid
      );
    }
    
    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isPhysiotherapist() && resource.data.physiotherapistId == request.auth.uid
      );
      allow create: if isPhysiotherapist() || isAdmin();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isPhysiotherapist() && resource.data.physiotherapistId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        isPhysiotherapist() && resource.data.physiotherapistId == request.auth.uid
      );
    }
    
    // Workouts collection
    match /workouts/{workoutId} {
      allow read: if true; // Public read for workout library
      allow create: if isTrainer() || isAdmin();
      allow update: if isTrainer() || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Exercises collection
    match /exercises/{exerciseId} {
      allow read: if true; // Public read for exercise library
      allow create: if isTrainer() || isAdmin();
      allow update: if isTrainer() || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Access keys collection
    match /access-keys/{keyId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isSuperadmin();
    }
    
    // Settings collection
    match /settings/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if true; // Allow creating settings for new users
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if resource.data.userId == request.auth.uid;
      allow create: if true; // Allow creating notifications
      allow update: if resource.data.userId == request.auth.uid;
      allow delete: if resource.data.userId == request.auth.uid;
    }
    
    // Workout logs collection
    match /workout-logs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isTrainer() || 
        isAdmin()
      );
      allow create: if true; // Allow logging workouts
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
