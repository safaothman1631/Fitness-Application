rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - Semi-protected
    match /users/{userId} {
      // Anyone can read (needed for app to function)
      allow read: if true;
      
      // Anyone can create (for registration)
      allow create: if request.resource.data.keys().hasAll(['email', 'name', 'role', 'membership'])
                    && request.resource.data.role == 'user'
                    && request.resource.data.membership in ['Free', 'Basic', 'Premium', 'Pro'];
      
      // Only update own document or if document email matches
      allow update: if request.resource.data.email == resource.data.email;
      
      // No public delete
      allow delete: if false;
    }
    
    // Other collections - Read-only for now
    match /workouts/{workoutId} {
      allow read: if true;
      allow write: if false; // Disable until admin system is ready
    }
    
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /physiotherapists/{physioId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /trainers/{trainerId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Settings - Can create and update own settings
    match /settings/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.keys().hasAny(['notifications', 'privacy', 'language']);
      allow delete: if false;
    }
    
    // Block everything else
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}

