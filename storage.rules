rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny all
    match /{allPaths=**} {
      allow read: if true;  // Allow public read for all files
      allow write: if false;
    }
    
    // Allow authenticated users to upload to ads folder
    match /ads/{fileName} {
      allow read: if true;  // Public read
      allow write: if request.auth != null  // Must be authenticated
                  && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                  && request.resource.contentType.matches('image/.*');  // Only images
    }
    
    // Allow authenticated users to upload to exercises folder
    match /exercises/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                  && request.resource.size < 10 * 1024 * 1024  // Max 10MB
                  && request.resource.contentType.matches('image/.*');
    }
    
    // Allow authenticated users to upload to meals folder
    match /meals/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                  && request.resource.size < 10 * 1024 * 1024
                  && request.resource.contentType.matches('image/.*');
    }
    
    // Allow authenticated users to upload to users folder
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                  && request.auth.uid == userId;  // Only own folder
    }
    
    // Allow authenticated users to upload profile images
    match /profile-images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                  && request.resource.size < 5 * 1024 * 1024
                  && request.resource.contentType.matches('image/.*');
    }
    
    // Admin-only access for other paths
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
