{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "build": {
    "env": {
      "ENABLE_EXPERIMENTAL_COREPACK": "0"
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh-videos",
      "schedule": "0 0 */15 * *"
    }
  ]
}
